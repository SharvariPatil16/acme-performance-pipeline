# Local settings for run_local.sh. Copy to .env.local (git-ignored) and adjust.
# Variable names follow docs/data-engineer.md -> "Database Environment Variables".
IS_LOCAL=true

# Local PostgreSQL installed by bin/setup-environment.sh (its documented local defaults).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=acme_performance
POSTGRES_USER=postgres
POSTGRES_PASS=postgres123

# Data lake bucket. In AWS your IAM policy only allows names containing your participant id.
DATA_LAKE_BUCKET=coding-workshop-datalake-1bd9f4ac
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

LOG_LEVEL=INFO
